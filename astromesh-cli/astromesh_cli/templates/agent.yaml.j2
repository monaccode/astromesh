apiVersion: astromesh/v1
kind: Agent
metadata:
  name: {{ name }}
spec:
  identity:
    display_name: "{{ display_name }}"
    description: "{{ description }}"
  model:
    primary:
      provider: {{ provider }}
      model: {{ model }}
      temperature: {{ temperature }}
      max_tokens: {{ max_tokens }}
{% if context_window %}
      context_window: {{ context_window }}
{% else %}
      # Declare the model's window so the runtime sizes the history budget:
      # context_window: 128000
{% endif %}
    routing:
      strategy: quality_first
  prompts:
    system: |
      You are {{ display_name }}, a helpful AI assistant.
  orchestration:
    pattern: {{ orchestration_pattern }}
    max_iterations: 10
    timeout: 30
{% if tools %}
  tools:
{% for tool in tools %}
    - name: {{ tool }}
{% endfor %}
{% endif %}
  guardrails:
    input:
      - type: pii_detection   # redact (default) | block | warn
      - type: max_length      # truncate (default) | block
        max_chars: 10000
    output:
      - type: pii_detection
      - type: cost_limit      # blocks the run past this many output tokens
        max_tokens_per_turn: 4000
  # An OKF knowledge bundle (a directory) adds the kb_index/kb_read/kb_find tools:
  # knowledge:
  #   bundle: ./knowledge/{{ name }}
