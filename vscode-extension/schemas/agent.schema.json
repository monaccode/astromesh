{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astromesh.dev/schemas/agent.schema.json",
  "title": "Astromesh Agent",
  "description": "Schema for Astromesh agent configuration files (*.agent.yaml)",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "astromesh/v1",
      "description": "API version. Must be 'astromesh/v1'."
    },
    "kind": {
      "type": "string",
      "const": "Agent",
      "description": "Resource kind. Must be 'Agent'."
    },
    "metadata": {
      "type": "object",
      "description": "Agent metadata.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique agent identifier. Must be kebab-case.",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "version": {
          "type": "string",
          "description": "Semantic version string (e.g. '1.0.0').",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "namespace": {
          "type": "string",
          "description": "Logical namespace for grouping agents.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "labels": {
          "type": "object",
          "description": "Arbitrary key/value labels.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "description": "Agent specification.",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "object",
          "description": "Human-facing identity information.",
          "additionalProperties": false,
          "properties": {
            "display_name": {
              "type": "string",
              "description": "Human-readable name displayed in UIs."
            },
            "description": {
              "type": "string",
              "description": "Short description of what the agent does."
            },
            "avatar": {
              "type": "string",
              "description": "Avatar identifier or URL."
            }
          }
        },
        "model": {
          "type": "object",
          "description": "LLM model configuration.",
          "additionalProperties": false,
          "properties": {
            "extra": {
              "type": "object",
              "description": "Further legacy candidates, keyed by an arbitrary name. Each value is a model block and joins the 'default' role after primary and fallback.",
              "additionalProperties": {
                "$ref": "#/$defs/modelConfig"
              }
            },
            "default": {
              "$ref": "#/$defs/roleConfig",
              "description": "Candidates for the 'default' role — the models used when no role is requested."
            },
            "roles": {
              "type": "object",
              "description": "Per-role model candidates, so a planner and a worker can run on different models within one agent. Using 'default'/'roles' switches the whole block to the role schema; 'primary'/'fallback'/'extra' are then ignored.",
              "additionalProperties": {
                "$ref": "#/$defs/roleConfig"
              }
            },
            "primary": {
              "$ref": "#/$defs/modelConfig",
              "description": "Primary model configuration (legacy schema; collapses into the 'default' role)."
            },
            "fallback": {
              "$ref": "#/$defs/modelConfig",
              "description": "Fallback model used when the primary is unavailable."
            },
            "routing": {
              "type": "object",
              "description": "Model routing configuration.",
              "additionalProperties": false,
              "properties": {
                "strategy": {
                  "type": "string",
                  "description": "Routing strategy.",
                  "enum": [
                    "cost_optimized",
                    "latency_optimized",
                    "quality_first",
                    "round_robin",
                    "capability_match"
                  ]
                },
                "health_check_interval": {
                  "type": "integer",
                  "description": "Seconds between provider health checks.",
                  "minimum": 1
                }
              }
            }
          }
        },
        "prompts": {
          "type": "object",
          "description": "Prompt templates for the agent.",
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string",
              "description": "System prompt. Supports Jinja2 template syntax."
            },
            "context": {
              "type": "string",
              "description": "Template Jinja de lo que cambia en cada turno (RAG, prefetch). Se antepone al mensaje del usuario actual para que system, tools e historial sean un prefijo estable para el caché del proveedor."
            }
          }
        },
        "orchestration": {
          "type": "object",
          "description": "Execution orchestration settings.",
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Orchestration pattern to use.",
              "enum": [
                "react",
                "plan_and_execute",
                "pipeline",
                "parallel_fan_out",
                "supervisor",
                "swarm",
                "glyph"
              ]
            },
            "max_iterations": {
              "type": "integer",
              "description": "Maximum number of reasoning/tool-call iterations.",
              "minimum": 1
            },
            "max_tool_result_tokens": {
              "type": "integer",
              "minimum": 1,
              "description": "Tope por defecto de tokens del resultado de una tool para este agente (default 8000)."
            },
            "timeout_seconds": {
              "type": "integer",
              "description": "Maximum wall-clock seconds before the run is cut (HTTP 504, error 'timeout'). The provider HTTP timeout is 120 s, so use >= 120 or omit.",
              "minimum": 1
            },
            "timeout": {
              "type": "integer",
              "description": "Alias for timeout_seconds (deprecated — prefer timeout_seconds).",
              "minimum": 1
            },
            "narrate": {
              "type": "boolean",
              "description": "Only for pattern: glyph. Default true: a second model call turns the program's result into prose. false returns the result as JSON — no second call."
            },
            "max_repairs": {
              "type": "integer",
              "description": "Only for pattern: glyph. Default 2: retries when the model-generated program fails to compile.",
              "minimum": 0
            },
            "stages": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": "Pipeline stage names (pattern: pipeline): 2 to 6 names of 1 to 40 characters. Without it: analyze, process, synthesize."
            },
            "max_handoffs": {
              "type": "integer",
              "minimum": 1,
              "description": "Only for pattern: swarm. Maximum chain of handoffs between agents (default 3)."
            }
          }
        },
        "tools": {
          "type": "array",
          "description": "Tools available to the agent.",
          "items": {
            "type": "object",
            "description": "Tool definition.",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique tool name used in function-calling."
              },
              "type": {
                "type": "string",
                "description": "Tool integration type. Only these three load from an agent YAML file.",
                "enum": [
                  "builtin",
                  "agent",
                  "client"
                ]
              },
              "max_result_tokens": {
                "type": "integer",
                "minimum": 1,
                "description": "Tope de tokens del resultado de esta tool al entrar al mensaje del modelo (orchestration/observaciones.py). Sin él rige orchestration.max_tool_result_tokens o 8000."
              },
              "description": {
                "type": "string",
                "description": "Human-readable description exposed to the LLM."
              },
              "agent": {
                "type": "string",
                "description": "Target agent name when type is 'agent'."
              },
              "context_transform": {
                "type": "string",
                "description": "Jinja2 expression to transform context before invoking the tool."
              },
              "config": {
                "type": "object",
                "description": "Tool-specific configuration.",
                "additionalProperties": true
              },
              "parameters": {
                "type": "object",
                "description": "Parameter definitions for this tool.",
                "additionalProperties": true
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "description": "Memory backend configuration.",
          "additionalProperties": false,
          "properties": {
            "conversational": {
              "type": "object",
              "description": "Chat-history (conversational) memory.",
              "additionalProperties": false,
              "properties": {
                "backend": {
                  "type": "string",
                  "description": "Conversational backend. NOTE: today `build_conversation_backend` only constructs `redis` (astromesh/memory/factory.py); the other values are accepted by this schema but the runtime degrades to NO memory with a warning. The enum is left wide so existing manifests keep validating — narrow it when the factory implements them.",
                  "enum": [
                    "sqlite",
                    "redis",
                    "postgres",
                    "in_memory"
                  ]
                },
                "strategy": {
                  "type": "string",
                  "description": "Context-window management strategy.",
                  "enum": [
                    "sliding_window",
                    "summary",
                    "token_budget"
                  ]
                },
                "max_messages": {
                  "type": "integer",
                  "description": "Maximum number of messages to retain.",
                  "minimum": 1
                },
                "max_turns": {
                  "type": "integer",
                  "description": "Alias for max_messages (turn = user+assistant pair).",
                  "minimum": 1
                },
                "ttl": {
                  "type": "integer",
                  "description": "Time-to-live in seconds for stored conversations.",
                  "minimum": 1
                },
                "connection": {
                  "type": "object",
                  "description": "Connection for the backend. `redis` REQUIRES it: the factory reads conv_config['connection']['url'] with no default (astromesh/memory/factory.py), so a manifest without it loads the agent and then runs it WITHOUT memory. The schema used to forbid this key outright, which made every manifest that actually works fail validation.",
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "Backend DSN, e.g. redis://localhost:6379."
                    }
                  },
                  "required": [
                    "url"
                  ]
                }
              }
            },
            "semantic": {
              "type": "object",
              "description": "Vector-embedding (semantic) memory. Requires `embeddings` and the backend's extra (astromesh[chromadb|faiss|qdrant|postgres|embeddings]).",
              "additionalProperties": false,
              "required": [
                "embeddings"
              ],
              "properties": {
                "backend": {
                  "type": "string",
                  "description": "Vector store backend.",
                  "enum": [
                    "chromadb",
                    "faiss",
                    "pgvector",
                    "qdrant"
                  ]
                },
                "embeddings": {
                  "type": "object",
                  "description": "Embedder, same shape as the RAG embedder (provider, model, endpoint).",
                  "additionalProperties": true,
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    }
                  }
                },
                "path": {
                  "type": "string",
                  "description": "Local storage path (chromadb, faiss)."
                },
                "connection": {
                  "type": "object",
                  "description": "Connection settings; `url` is required for pgvector.",
                  "additionalProperties": true,
                  "properties": {
                    "url": {
                      "type": "string"
                    }
                  }
                },
                "dimension": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Vector dimension; required for faiss, pgvector and qdrant."
                },
                "similarity_threshold": {
                  "type": "number",
                  "description": "Minimum cosine similarity for retrieval.",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_results": {
                  "type": "integer",
                  "description": "Maximum number of semantic results to inject.",
                  "minimum": 1
                }
              }
            },
            "episodic": {
              "type": "object",
              "description": "Event-log (episodic) memory: one episode per run.",
              "additionalProperties": true,
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "postgres"
                  ]
                },
                "connection": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "knowledge": {
          "type": "object",
          "description": "Knowledge configuration: a RAGPipeline retrieved at run time, an OKF knowledge bundle the agent navigates with kb_index/kb_read/kb_find, or both.",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "pipeline"
              ]
            },
            {
              "required": [
                "bundle"
              ]
            }
          ],
          "properties": {
            "pipeline": {
              "type": "string",
              "description": "metadata.name of a RAGPipeline resource to retrieve from."
            },
            "top_k": {
              "type": "integer",
              "description": "Number of chunks to retrieve per run (defaults to the pipeline's retrieval.top_k). Applies to pipeline only."
            },
            "bundle": {
              "type": "string",
              "description": "Directory of an Open Knowledge Format (OKF) bundle, relative to the config directory or absolute. Registers kb_index, kb_read and kb_find, and exposes bundle_index to the prompt templates."
            }
          }
        },
        "guardrails": {
          "type": "object",
          "description": "Input and output guardrails.",
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "array",
              "description": "Guardrails applied to incoming user messages.",
              "items": {
                "$ref": "#/$defs/guardrailRule"
              }
            },
            "output": {
              "type": "array",
              "description": "Guardrails applied to LLM responses.",
              "items": {
                "$ref": "#/$defs/guardrailRule"
              }
            }
          }
        },
        "observability": {
          "type": "object",
          "description": "Tracing and metrics configuration.",
          "additionalProperties": false,
          "properties": {
            "tracing": {
              "type": "boolean",
              "description": "Enable distributed tracing."
            },
            "metrics": {
              "type": "boolean",
              "description": "Enable metrics collection."
            },
            "collector": {
              "type": "string",
              "description": "Telemetry collector backend.",
              "enum": [
                "stdout",
                "otlp",
                "internal"
              ]
            },
            "sample_rate": {
              "type": "number",
              "description": "Fraction of requests to sample (0.0–1.0).",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "permissions": {
          "type": "object",
          "description": "Tool whitelist/blacklist by registered tool name (fnmatch wildcards). `denied_actions` wins. Other keys are ignored with a warning.",
          "additionalProperties": true,
          "properties": {
            "allowed_actions": {
              "type": "array",
              "description": "Registered tool names the agent may use (wildcards allowed). A name that matches no tool leaves it out.",
              "items": {
                "type": "string"
              }
            },
            "denied_actions": {
              "type": "array",
              "description": "Registered tool names (wildcards allowed) the agent may never use.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "Forma de la salida estructurada del agente. Acepta JSON Schema completo (type: object + properties) o la taquigrafía plana {campo: {type: ...}}, la misma que los `parameters` de las tools. El runtime la parsea de la respuesta y la deja validada en result.data."
        },
        "program": {
          "type": "string",
          "description": "Sólo con orchestration.pattern: glyph. Programa Glyph fijo, escrito de antemano: el runtime lo compila al arrancar contra `tools` y lo ejecuta en cada corrida sin llamar al modelo. Si no compila, el agente no carga."
        },
        "chain": {
          "type": "object",
          "description": "Agentes a disparar cuando este termina. Se compila a un workflow al arrancar.",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "sequential",
                "parallel"
              ],
              "default": "sequential"
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "on_complete": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "agent": {
                    "type": "string",
                    "description": "Agente a disparar."
                  },
                  "when": {
                    "type": "string",
                    "description": "Condición Jinja. Sin `when` el eslabón dispara siempre."
                  },
                  "input": {
                    "type": "string",
                    "description": "Entrada del eslabón. Default: {{ output.answer }}."
                  },
                  "default": {
                    "type": "boolean",
                    "description": "Dispara sólo si ningún `when` de la cadena matcheó. Incompatible con `when`."
                  },
                  "retry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "max_attempts": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "backoff": {
                        "type": "string",
                        "enum": [
                          "fixed",
                          "exponential"
                        ]
                      },
                      "initial_delay_seconds": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "on_error": {
                    "type": "string",
                    "description": "'continue' sigue la cadena, un nombre de agente salta ahí. Sin declarar, corta."
                  }
                },
                "required": [
                  "agent"
                ]
              }
            }
          },
          "required": [
            "on_complete"
          ]
        }
      }
    }
  },
  "$defs": {
    "roleConfig": {
      "type": "object",
      "description": "Candidate models for one role, tried in order by the role's router.",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "description": "Model blocks for this role, in preference order.",
          "items": {
            "$ref": "#/$defs/modelConfig"
          }
        },
        "strategy": {
          "type": "string",
          "description": "Routing strategy for this role (default 'cost_optimized').",
          "enum": [
            "cost_optimized",
            "latency_optimized",
            "quality_first",
            "round_robin",
            "capability_match"
          ]
        }
      }
    },
    "modelConfig": {
      "type": "object",
      "description": "Configuration for a single LLM model endpoint.",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Adapter that serves this model. Preferred over the legacy 'provider' key. Omitted, it is inferred: 'litellm' for prefixed models (containing '/'), 'openai_compat' otherwise.",
          "enum": [
            "ollama",
            "openai",
            "openai_compat",
            "azure_openai",
            "litellm",
            "centinela"
          ]
        },
        "provider": {
          "type": "string",
          "description": "Legacy alias for 'source'. Prefer 'source' in new agents.",
          "enum": [
            "ollama",
            "openai",
            "openai_compat",
            "azure_openai",
            "litellm",
            "centinela"
          ]
        },
        "providerRef": {
          "type": "string",
          "description": "Name of an entry in the provider registry to resolve this block from. The registry supplies source/endpoint/api_key/contract; keys set here override it."
        },
        "model": {
          "type": "string",
          "description": "Model name or tag (e.g. 'llama3.1:8b', 'gpt-4o-mini'). For 'litellm', the provider-prefixed form (e.g. 'anthropic/claude-opus-4-8')."
        },
        "endpoint": {
          "type": "string",
          "description": "Base URL for the model API. Not used by 'litellm', which routes on the model prefix.",
          "format": "uri"
        },
        "endpoint_name": {
          "type": "string",
          "description": "Named endpoint, used by the 'centinela' source."
        },
        "api_key": {
          "type": "string",
          "description": "API key as a literal value. Prefer 'api_key_env' so the key stays out of the YAML."
        },
        "api_key_env": {
          "type": "string",
          "description": "Name of the environment variable holding the API key."
        },
        "contract": {
          "type": "object",
          "description": "Label contract for the 'centinela' source."
        },
        "invalid_policy": {
          "type": "string",
          "description": "What to do with a response that violates the contract ('centinela' source)."
        },
        "max_retries": {
          "type": "integer",
          "description": "Retries on an invalid response ('centinela' source).",
          "minimum": 0
        },
        "timeout": {
          "type": "number",
          "description": "HTTP client timeout in seconds for requests to this model (default 120). Raise it for reasoning models whose time-to-first-token can exceed the default.",
          "exclusiveMinimum": 0
        },
        "temperature": {
          "type": "number",
          "description": "Sampling temperature (top-level shorthand for parameters.temperature).",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "description": "Maximum tokens to generate (top-level shorthand).",
          "minimum": 1
        },
        "context_window": {
          "type": "integer",
          "minimum": 1,
          "description": "Tokens de entrada que acepta el modelo. Fija el presupuesto del historial conversacional. Sin esto: num_ctx (Ollama), litellm, o 32000."
        },
        "parameters": {
          "type": "object",
          "description": "Additional model parameters passed verbatim to the provider.",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "top_p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "top_k": {
              "type": "integer",
              "minimum": 1
            },
            "frequency_penalty": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "presence_penalty": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "stop": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Stop sequences."
            }
          }
        }
      }
    },
    "guardrailRule": {
      "type": "object",
      "description": "A single guardrail rule. Unknown keys are ignored with a warning at load time.",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "pii_detection (input/output), topic_filter (input), max_length (input), content_filter (output), cost_limit (run budget; either side).",
          "enum": [
            "pii_detection",
            "topic_filter",
            "max_length",
            "content_filter",
            "cost_limit"
          ]
        },
        "action": {
          "type": "string",
          "description": "pii_detection: redact|block|warn (default redact). topic_filter: warn|block (default warn). max_length: truncate|block (default truncate). content_filter: redact|block (default redact). cost_limit always blocks.",
          "enum": [
            "redact",
            "block",
            "warn",
            "truncate"
          ]
        },
        "message": {
          "type": "string",
          "description": "Answer returned when this rule blocks. Default: \"I can't help with that request.\""
        },
        "blocked_topics": {
          "type": "array",
          "description": "topic_filter: case-insensitive substrings. Alias: forbidden_topics.",
          "items": {
            "type": "string"
          }
        },
        "forbidden_topics": {
          "type": "array",
          "description": "Alias of blocked_topics.",
          "items": {
            "type": "string"
          }
        },
        "max_chars": {
          "type": "integer",
          "description": "max_length: character limit (default 10000). Alias: max_characters.",
          "minimum": 1
        },
        "max_characters": {
          "type": "integer",
          "description": "Alias of max_chars.",
          "minimum": 1
        },
        "blocked_patterns": {
          "type": "array",
          "description": "content_filter: case-insensitive regular expressions.",
          "items": {
            "type": "string"
          }
        },
        "forbidden_keywords": {
          "type": "array",
          "description": "content_filter: literal case-insensitive keywords.",
          "items": {
            "type": "string"
          }
        },
        "max_tokens_per_turn": {
          "type": "integer",
          "description": "cost_limit: token budget for the whole run, checked before each model call.",
          "minimum": 1
        },
        "count": {
          "type": "string",
          "description": "cost_limit: count output tokens (default) or input+output.",
          "enum": [
            "output",
            "total"
          ]
        }
      }
    }
  }
}
