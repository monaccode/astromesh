---
import ProductShowcase from './ProductShowcase.astro';

import { COMPONENTS } from '../data/ecosystem';
const version = COMPONENTS.find((c) => c.id === 'a2a')!.version;

// Output of `python -m astromesh_a2a.eval` with the default policy, as recorded in the
// astromesh-a2a repo (docs/eval.md); details trimmed to fit the panel.
const lines = [
  { t: 'python -m astromesh_a2a.eval', k: 'cmd' },
  { t: 'trap               stopped', k: 'comment' },
  { t: 'card_spoof         yes   requests to host B: 0', k: 'str' },
  { t: 'redirect_internal  yes   internal hits: 0', k: 'str' },
  { t: 'dns_private        yes   reached a socket: 0', k: 'str' },
  { t: 'injection_text     yes   one intact, escaped block', k: 'str' },
  { t: 'self_confirm       yes   RPCs sent: 1, no reply', k: 'str' },
  { t: '9/9 traps stopped', k: 'plain' },
];

const features = [
  { icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`, label: 'Policy first', desc: 'Nothing reachable until you list it' },
  { icon: `<circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>`, label: 'Pinned egress', desc: 'No SSRF, no rebinding, no redirects' },
  { icon: `<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>`, label: 'Untrusted output', desc: 'Remote words wrapped and escaped' },
  { icon: `<path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/>`, label: 'Never auto-confirms', desc: 'A remote “yes” is an agent turn' },
  { icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>`, label: '9 frameworks', desc: 'LangChain, CrewAI, ADK, MCP, …' },
  { icon: `<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>`, label: 'Core, ADK, Nexus', desc: 'type: a2a, remote_a2a(), served cards' },
];
---

<ProductShowcase
  logo="/astromesh/logos/a2a-mark.svg"
  name="A2A"
  version={version}
  badge="LIBRARY"
  tagline="Talk to other agents without trusting them"
  description="A client and a server for the A2A 1.0 protocol on the official SDK. Every remote is checked against a policy, its output reaches your model wrapped as untrusted, and a remote can never confirm anything for your user."
  accent="#34d399"
  accentDeep="#059669"
  panelTitle="a2a · the attack eval, default policy"
  lines={lines}
  features={features}
  terminal={['pip install astromesh-a2a']}
  ctaPrimary={{ text: 'Call a remote agent', href: '/astromesh/a2a/library/' }}
  ctaSecondary={{ text: 'Read the Docs', href: '/astromesh/a2a/introduction/' }}
/>
