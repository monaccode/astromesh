---
// Starlight's default footer plus the maker line: Astromesh is built by FAiNANSU.
import Default from '@astrojs/starlight/components/Footer.astro';

const logo = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/fainansu-logo.png`;
---

<Default><slot /></Default>

<a class="maker" href="https://fainansu.tech" target="_blank" rel="noopener">
  <span>Built by</span>
  <img src={logo} alt="FAiNANSU" width="96" height="24" />
</a>

<style>
  .maker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .maker:hover {
    color: var(--sl-color-white);
  }
  .maker img {
    height: 1.4rem;
    width: auto;
  }
</style>
