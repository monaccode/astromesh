---
import ProductShowcase from './ProductShowcase.astro';

import { COMPONENTS } from '../data/ecosystem';
const version = COMPONENTS.find((c) => c.id === 'rag')!.version;

// Real output of `uv run python examples/hybrid.py` in the astromesh-rag repo,
// offline (test embedder): only the trace is shown, because offline scores mean nothing.
const lines = [
  { t: 'uv run python examples/hybrid.py', k: 'cmd' },
  { t: '> ¿Qué significa ERR-4012?', k: 'plain' },
  { t: '  trace:', k: 'comment' },
  { t: '    retrieve  vector    1.0 ms  1->10', k: 'str' },
  { t: '    retrieve  bm25      0.2 ms  1->10', k: 'str' },
  { t: '    fuse      RRF       0.0 ms  20->10', k: 'str' },
  { t: '    context   context   0.0 ms  10->5', k: 'str' },
];

const features = [
  { icon: `<path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>`, label: '4 patterns', desc: 'naive, hybrid, multi_query, hyde' },
  { icon: `<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>`, label: 'A trace per query', desc: 'Every stage: ms, in, out, error' },
  { icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`, label: '5 vector stores', desc: 'memory, FAISS, Chroma, Qdrant, pgvector' },
  { icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>`, label: 'Python or YAML', desc: 'kind: RAGPipeline, one line per pattern' },
  { icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>`, label: 'Open registry', desc: 'Register a part, use it by name' },
  { icon: `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`, label: 'Labeled benchmark', desc: '200 docs, 60 questions, 4 traps' },
];
---

<ProductShowcase
  name="RAG"
  version={version}
  badge="LIBRARY"
  tagline="Every RAG pattern, one set of parts"
  description="Ingest, retrieve, rank and build the context from small, swappable parts. Switch pattern by changing one line, and read in the trace what each stage did."
  accent="#fbbf24"
  accentDeep="#d97706"
  panelTitle="rag · one hybrid query, offline"
  lines={lines}
  features={features}
  terminal={['pip install "git+https://github.com/monaccode/astromesh-rag@v0.1.0"']}
  ctaPrimary={{ text: 'Choose a pattern', href: '/astromesh/rag/patterns/' }}
  ctaSecondary={{ text: 'Read the Docs', href: '/astromesh/rag/introduction/' }}
/>
